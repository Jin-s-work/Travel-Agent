# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요.
# cp .env.example .env

# OpenAI API 키 (필수)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily API 키 (웹 검색 도구용, 없으면 web_search가 비활성)
# https://tavily.com 에서 무료 발급
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 추출용 모델 (선택, 기본값 gpt-5-mini)
EXTRACTION_MODEL=gpt-5-mini

# 답변 생성 / 에이전트 모델 (선택, 기본값 gpt-5-mini)
ANSWER_MODEL=gpt-5-mini
AGENT_MODEL=gpt-5-mini

# 임베딩 모델 (선택)
EMBEDDING_MODEL=text-embedding-3-small

# 추론 강도 (선택, 기본값 low)
# 응답 시간의 대부분이 추론 토큰 생성에 쓰인다. low로 두면 기본값 대비 2배 이상
# 빠르면서 평가 지표가 그대로다. minimal은 쓰지 말 것 — 근거가 있는데도 거절한다.
REASONING_EFFORT=low

# 기동 시 인덱스가 비어 있으면 데모 예약으로 자동으로 채운다 (선택, 기본값 켜짐)
# 0으로 두면 끈다. 자기 메일만 다루고 싶을 때 쓴다.
SEED_ON_EMPTY=1

# 저장 위치 (선택, 기본값 data/chroma·data/emails)
# 배포에서 별도 디스크를 붙일 때 쓴다. 테스트는 conftest가 임시 경로로 덮어쓴다.
# CHROMA_DIR=/var/data/chroma
# EMAILS_DIR=/var/data/emails
