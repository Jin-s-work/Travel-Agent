# 로컬 개발용 이름/기본값 목록. 운영 비밀은 호스팅 Environment/Secret Files에서만 입력하세요.
# cp .env.example .env

# OpenAI API 키 (선택: AI 상세 분석·임베딩·생성 답변용; 기본 메일 분석·날짜별 예약 조회는 키 없이 가능)
OPENAI_API_KEY=

# 메일 분석 방식. 기본 auto는 유료 호출을 자동 승인하지 않습니다.
# auto: AI 키·단가·양수 예산·외부 호출 허용이 모두 유효하면 AI, 아니면 무료 기본 분석.
# local: 외부 AI·임베딩을 호출하지 않고 명시된 날짜/장소/예약 필드를 기본 규칙으로 분석.
# ai: AI 상세 분석 우선. 안전 조건 미충족 시 기본 분석으로 전환하며 과금 제한을 우회하지 않음.
# 기본 분석은 모든 메일 형식을 이해하지 못합니다. 결과 확인·교정/수동 입력과 원문 확인이 필요합니다.
# ZERO_SPEND=1에서도 기본 분석과 저장된 예약의 날짜별 조회는 사용할 수 있습니다.
# Render: scripts/prepare_render_env.py --profile openai 로 명시적으로 켭니다.
# 운영 OpenAI 정책: 전체 $0.50/일·$3/월, 사용자 $0.25/일·$1/월 (UTC).
# 정책 파일: deploy/render-supabase/pricing-openai.json. 서버·DB는 Free 유지.
MAIL_ANALYSIS_MODE=auto

# Tavily API 키 (웹 검색 도구용, 없으면 web_search가 비활성)
# https://tavily.com 에서 무료 발급
TAVILY_API_KEY=

# 추출용 모델 (선택, 기본값 gpt-5-mini)
EXTRACTION_MODEL=gpt-5-mini

# 답변 생성 / 에이전트 모델 (선택, 기본값 gpt-5-mini)
ANSWER_MODEL=gpt-5-mini
AGENT_MODEL=gpt-5-mini

# 임베딩 모델 (선택)
EMBEDDING_MODEL=text-embedding-3-small

# 추론 강도 (선택, 기본값 low)
# 응답 시간의 대부분이 추론 토큰 생성에 쓰인다. low로 두면 기본값 대비 2배 이상
# 빠르면서 평가 지표가 그대로다. minimal은 쓰지 말 것 — 근거가 있는데도 거절한다.
REASONING_EFFORT=low

# 개인 웹 서비스는 공용 데모 자동 주입을 하지 않습니다.
SEED_ON_EMPTY=0

# 저장 위치 (선택, 기본값 data/chroma·data/emails)
# 배포에서 별도 디스크를 붙일 때 쓴다. 테스트는 conftest가 임시 경로로 덮어쓴다.
# CHROMA_DIR=/var/data/chroma
# EMAILS_DIR=/var/data/emails

# 비공개 서비스 인증: 설정 전 개인 API는 401로 닫힙니다.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
# 난수 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
# callback: http://localhost:8000/api/v2/auth/callback
# 운영: APP_ENV=production, PUBLIC_BASE_URL=https://실제도메인
DATABASE_PATH=data/service.sqlite3
DOCUMENTS_DIR=data/private-documents
VECTORS_DIR=data/private-vectors

# 2단계: 실제 단가·통화별 예산 설정 전 유료 호출은 차단됩니다.
# docs/service-v2/examples/pricing-policy.template.json의 빈 값을 확인 후 설정하세요.
PRICING_CONFIG=
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=20
# SQLite·원문·Chroma·DB 옆 private-job-artifacts를 같은 영구 디스크에 보존하세요.
# 단일 uvicorn 프로세스만 지원합니다. --workers 1

# 3단계: Apify 설정만으로 수집/운영이 켜지지 않습니다.
# 관리자 화면의 개별 이용 범위, 원격 보관/삭제 기한, 예산 검토가 필요합니다.
APIFY_TOKEN=
# 공식 Actor 계약을 검토한 숫자 build로 고정. latest 자동 추적 금지.
APIFY_REVIEW_BUILD=0.0.527
# research/production 플래그는 SQLite에서 관리하며 최초 생성 시 둘 다 OFF.
# 로컬 Lingua 모델은 requirements에 포함되어 있고 서버 시작 시 다운로드하지 않습니다.

# 06 운영 launcher는 APP_ENV=production, HTTPS OIDC, 아래 실제 mount를 요구합니다.
# 로컬 uvicorn 개발 실행에서는 mount를 요구하지 않습니다.
PERSISTENT_STORAGE_ROOT=
WEB_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_DEADLINE_SECONDS=900
JOB_SHUTDOWN_SECONDS=5
# 외부 백업: 운영 디스크와 별도 S3 호환 bucket. 자격 증명은 secret에만 입력.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=travel-agent
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 무작위 32바이트를 base64로 인코딩한 암호화 키. 복구용 사본은 호스트 외부에 보관.
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_CHECKPOINT_SECONDS=300
BACKUP_RETENTION_DAYS=7
# 백업 scheduler는 명시적 ON과 모든 설정을 요구합니다. 미설정은 실제 배포 gate.
BACKUP_ENABLED=0

# Render Free + Supabase Free profile: deploy/render-supabase/.env.example
STORAGE_BACKEND=local
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=travel-private
ZERO_SPEND=0
JOB_POLL_SECONDS=0.25

# Phase 07: independent rollout switches (no new paid provider required).
PREPARATION_ENABLED=true
PLAN_B_ENABLED=true
# Explicit private-device opt-in and source-specific offline permission required.
OFFLINE_ENABLED=false

# Optional product analytics: explicit user opt-in; raw personal events only (1..90 days).
PRODUCT_EVENT_RETENTION_DAYS=30

# Optional location providers stay OFF when unset. See docs/service-v3/MIGRATION_12.md.
# Reviewed non-secret policy JSON file; not required for the free service.
LOCATION_PROVIDER_CONFIG=
# Optional server-only Google Maps key; a key alone never enables calls.
GOOGLE_MAPS_API_KEY=

# Free public-map discovery (no paid provider activation). Production defaults on;
# development defaults off. Explicit 0 disables new calls; valid cache stays readable.
# Shared cap: 20 fresh city queries/day, 5/user/day, 15s spacing, 7d city cache.
# City reference point only, radius 3km; max60 records fetched / 12 shown, unverified.
PUBLIC_DISCOVERY_ENABLED=1
