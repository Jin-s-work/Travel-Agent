# 환경 변수 (API 키)
.env
.env.local

# 실제 메일 데이터 (개인정보)
# 디렉터리를 통째로 제외하면 하위 파일을 다시 포함시킬 수 없으므로,
# 단계별로 열어둔 뒤 .gitkeep만 예외 처리한다.
data/*
!data/emails/
data/emails/*
!data/emails/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# 실행 산출물. 평가 리포트(eval_*.txt)는 근거로 남긴다.
reports/*.log
reports/*.json
reports/reindex_*.txt
reports/probe_*
reports/agent_*.txt

# macOS가 만드는 중복 사본 ("requirements 2.txt" 같은)
* [0-9].*

# OS / 에디터
.DS_Store
.idea/
.vscode/
