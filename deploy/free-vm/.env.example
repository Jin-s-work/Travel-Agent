# VM only. Copy to .env and chmod 600. Values are never committed.
# Use a directory on the verified persistent VM filesystem, owned by UID/GID1000.
HOST_DATA_DIR=/srv/travel-agent/data
HOST_TLS_DIR=/srv/travel-agent/tls
# One actual hostname you control. Do not include https:// or a path.
PUBLIC_HOST=
PUBLIC_BASE_URL=
SESSION_SECRET=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
# Compose forces every paid AI/maps/reviews API key empty and uses a halted $0 policy.
# No paid LLM extraction or semantic search in this profile. Manual entries/date questions work.
BACKUP_ENABLED=0
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=travel-agent
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_CHECKPOINT_SECONDS=300
BACKUP_RETENTION_DAYS=7
