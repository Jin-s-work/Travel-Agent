# Existing Render service Environment. Never commit actual values.
# Optional local handoff inputs, excluded by scripts/prepare_render_env.py:
# SUPABASE_DB_PASSWORD=
# DEPLOY_ADMIN_EMAIL=
# Keep DATABASE_URL blank to build it from the hii password with correct URL encoding.
STORAGE_BACKEND=supabase
# Supabase Connect > Session pooler (IPv4, port5432), URL-encode password.
# Append sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt on Render.
DATABASE_URL=
SUPABASE_URL=
# Server-only sb_secret_ key (legacy service_role also supported).
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=travel-private
APP_ENV=production
PUBLIC_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
SESSION_SECRET=
PYTHON_DOTENV_DISABLED=1
SEED_ON_EMPTY=0
WEB_CONCURRENCY=1
DATABASE_PATH=/tmp/travel-cache/sql/unused.sqlite3
DOCUMENTS_DIR=/tmp/travel-cache/documents
VECTORS_DIR=/tmp/travel-cache/vectors
JOB_POLL_SECONDS=3
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=20
JOB_SHUTDOWN_SECONDS=5
BACKUP_ENABLED=0
ZERO_SPEND=1
PRICING_CONFIG=/app/deploy/render-supabase/pricing-zero.json
OPENAI_API_KEY=
TAVILY_API_KEY=
APIFY_TOKEN=
