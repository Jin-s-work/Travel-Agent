# 이 파일을 .env로 복사한 뒤 아래 5개만 입력합니다. .env는 Git 제외입니다.
# Google Auth Platform → 웹 클라이언트
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Supabase hii → DB 비밀번호 / Settings → API Keys → 서버 Secret key
SUPABASE_DB_PASSWORD=
SUPABASE_SECRET_KEY=
# Google 로그인할 본인 이메일
DEPLOY_ADMIN_EMAIL=

# 세션 키: 최초 준비 시 안전한 난수로 생성. 기존 값은 유지합니다.
SESSION_SECRET=
# 고정 주소·무료 모드·저장 경로는 scripts/prepare_render_env.py에서 설정합니다.
# Render에는 입력 파일 대신 스크립트가 생성하는 .env.render를 가져옵니다.
